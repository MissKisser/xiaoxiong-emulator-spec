{
  "version": "1.1.0",
  "terms": [
    {
      "id": "instance",
      "zh": "实例",
      "en": "instance",
      "meaning": "一个独立可运行的 Android 环境，拥有自己的数据、标识与生命周期",
      "forbidden": ["模拟器实例", "虚拟机实例", "分身"]
    },
    {
      "id": "image",
      "zh": "镜像",
      "en": "image",
      "meaning": "用于创建实例的 Android 系统模板",
      "forbidden": ["系统镜像", "ROM 包", "安装包"]
    },
    {
      "id": "root",
      "zh": "Root 权限",
      "en": "root",
      "meaning": "实例内的管理员权限，Windows 端为真 root，Android 端为容器内 root",
      "forbidden": ["免 root", "超级用户权限"]
    },
    {
      "id": "exposure",
      "zh": "暴露级别",
      "en": "exposure",
      "meaning": "实例端口对外可达的范围，分 loopback / lan / public 三级",
      "forbidden": ["网络模式", "端口模式"]
    },
    {
      "id": "input-channel",
      "zh": "输入通道",
      "en": "input channel",
      "meaning": "向实例投递触摸与按键的通路，分原生输入与投屏",
      "forbidden": ["控制方式", "操控模式", "输入方式"]
    },
    {
      "id": "fidelity",
      "zh": "保真度",
      "en": "fidelity",
      "meaning": "实例在系统能力与运行特征上接近真机的程度",
      "forbidden": ["仿真度", "拟真度", "还原度"]
    },
    {
      "id": "startup",
      "zh": "启动",
      "en": "start",
      "meaning": "将实例从停止态转为运行态",
      "forbidden": ["开机", "启动虚拟机", "唤醒"]
    },
    {
      "id": "stop",
      "zh": "停止",
      "en": "stop",
      "meaning": "将实例从运行态转为停止态，保留数据",
      "forbidden": ["关机", "关闭虚拟机", "挂起"]
    },
    {
      "id": "error-environment",
      "zh": "宿主环境错误",
      "en": "EnvironmentError",
      "meaning": "宿主不满足运行前提，例如虚拟化组件缺失或未启用。必须在启动前拦截并给出修复指引",
      "forbidden": ["环境不支持", "宿主问题", "配置不兼容"]
    },
    {
      "id": "error-provider",
      "zh": "虚拟化实现错误",
      "en": "ProviderError",
      "meaning": "虚拟化实现内部失败。记录日志，实例转为 failed，允许重试",
      "forbidden": ["环境不支持", "宿主问题", "配置不兼容", "引擎错误", "底层故障"]
    },
    {
      "id": "error-guest",
      "zh": "实例内错误",
      "en": "GuestError",
      "meaning": "实例内出现问题，例如系统未启动或调试通路未就绪。超时后转为 failed 并保留日志",
      "forbidden": ["实例内异常", "来宾错误", "系统错误"]
    },
    {
      "id": "error-user",
      "zh": "配置错误",
      "en": "UserError",
      "meaning": "配置本身非法，例如磁盘空间不足、镜像不存在、端口被占用。立即返回，不进入 failed 态",
      "forbidden": ["用户错误", "参数错误", "非法参数", "设置有误"]
    },
    {
      "id": "snapshot",
      "zh": "快照",
      "en": "snapshot",
      "meaning": "在实例停止态对磁盘链做的可回退副本",
      "forbidden": ["备份点", "存档", "克隆"]
    },
    {
      "id": "projection",
      "zh": "投屏",
      "en": "projection",
      "meaning": "把实例画面实时呈现到宿主窗口。与输入通道是两个概念：投屏负责看，输入通道负责操控",
      "forbidden": ["镜像投射", "画面同步", "串流"]
    },
    {
      "id": "file-transfer",
      "zh": "文件传输",
      "en": "file transfer",
      "meaning": "在宿主与实例之间双向复制文件",
      "forbidden": ["文件共享", "文件同步", "上传下载"]
    },
    {
      "id": "diagnostics",
      "zh": "诊断包",
      "en": "diagnostics bundle",
      "meaning": "一键导出的现场材料，用于自助排查与社区求助。导出前必须让用户预览将包含的内容",
      "forbidden": ["日志包", "导出日志", "调试文件"]
    }
  ]
}
